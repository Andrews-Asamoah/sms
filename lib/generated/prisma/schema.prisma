generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  role               String              @default("user")
  banned             Boolean             @default(false)
  banReason          String?
  banExpires         DateTime?
  accounts           Account[]
  memberships        Member[]
  sessions           Session[]
  attendancesMarked  Attendance[]        @relation("AttendanceMarkedBy")
  auditLogs          AuditLog[]
  componentScores    ComponentScore[]
  documents          Document[]
  gradingSystems     GradingSystem[]
  invitations        Invitation[]
  paymentsRecorded   Payment[]           @relation("PaymentRecordedBy")
  transcriptRequests TranscriptRequest[]
  profile            UserProfile?

  @@index([email])
  @@index([role])
  @@index([banned])
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  impersonatedBy       String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([activeOrganizationId])
  @@index([impersonatedBy])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String? //can store additional school metadata here
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]
  school      School?

  @@index([slug])
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitation")
}

model School {
  id                          String                      @id @default(cuid())
  organizationId              String                      @unique
  name                        String
  code                        String                      @unique
  email                       String?
  phone                       String?
  address                     String?
  logo                        String?
  motto                       String?
  website                     String?
  subdomain                   String                      @unique
  currency                    String                      @default("GHS")
  timezone                    String                      @default("Africa/Accra")
  locale                      String                      @default("en-GH")
  primaryColor                String                      @default("#3B82F6")
  secondaryColor              String                      @default("#10B981")
  settings                    Json?
  features                    Json?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  academicYears               AcademicYear[]
  assessmentTemplates         AssessmentTemplate[]
  bills                       Bill[]
  chartAccounts               ChartAccount[]
  classes                     Class[]
  customExpenseCategories     CustomExpenseCategory[]
  customFeeCategories         CustomFeeCategory[]
  customTransactionCategories CustomTransactionCategory[]
  departments                 Department[]
  documents                   Document[]
  feeStructures               FeeStructure[]
  gradingSystems              GradingSystem[]
  guardians                   Guardian[]
  houses                      House[]
  payments                    Payment[]
  organization                Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff                       Staff[]
  students                    Student[]
  subjects                    Subject[]
  subscription                Subscription?
  teachers                    Teacher[]
  transactions                Transaction[]

  @@index([code])
  @@index([subdomain])
  @@index([organizationId])
  @@map("schools")
}

model UserProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  firstName             String
  lastName              String
  otherNames            String?
  phone                 String?
  alternatePhone        String?
  gender                Gender
  dateOfBirth           DateTime  @db.Date
  nationality           String?   @default("Ghanaian")
  residentialAddress    String?
  postalAddress         String?
  city                  String?
  region                String?
  country               String?   @default("Ghana")
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelationship String?
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  guardian              Guardian?
  staff                 Staff?
  student               Student?
  teacher               Teacher?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("user_profiles")
}

model Student {
  id                 String              @id @default(cuid())
  profileId          String              @unique
  schoolId           String
  studentId          String // Auto-generated school-specific ID
  admissionNumber    String?
  admissionDate      DateTime            @default(now()) @db.Date
  classId            String?
  departmentId       String?
  houseId            String?
  previousSchool     String?
  previousClass      String?
  bloodGroup         String?
  allergies          String?
  medicalConditions  String?
  outstandingBalance Decimal             @default(0) @db.Decimal(10, 2)
  status             StudentStatus       @default(ACTIVE)
  graduationDate     DateTime?           @db.Date
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assessmentScores   AssessmentScore[]
  attendances        Attendance[]
  bills              Bill[]
  documents          Document[]
  enrollments        Enrollment[]
  guardians          GuardianStudent[]
  payments           Payment[]
  remarks            Remark[]
  class              Class?              @relation(fields: [classId], references: [id])
  department         Department?         @relation(fields: [departmentId], references: [id])
  house              House?              @relation(fields: [houseId], references: [id])
  profile            UserProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transcripts        TranscriptRequest[]

  @@unique([studentId, schoolId])
  @@unique([admissionNumber, schoolId])
  @@index([schoolId, status])
  @@index([classId, schoolId])
  @@index([departmentId])
  @@index([houseId])
  @@index([profileId])
  @@map("students")
}

model Teacher {
  id                    String           @id @default(cuid())
  profileId             String           @unique
  schoolId              String
  teacherId             String // Auto-generated school-specific ID
  staffNumber           String?
  departmentId          String
  houseId               String?
  qualification         String?
  specialization        String?
  experience            Int?
  employmentType        EmploymentType   @default(FULL_TIME)
  hireDate              DateTime         @default(now()) @db.Date
  contractEndDate       DateTime?        @db.Date
  monthlySalary         Decimal?         @db.Decimal(10, 2)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  classesAsClassTeacher Class[]
  departmentsAsHead     Department[]     @relation("DepartmentHead")
  documents             Document[]
  housesAsHouseTeacher  House[]          @relation("HouseTeacher")
  remarks               Remark[]
  subjects              SubjectTeacher[]
  department            Department       @relation("TeacherDepartment", fields: [departmentId], references: [id])
  house                 House?           @relation("TeacherHouse", fields: [houseId], references: [id])
  profile               UserProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school                School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, schoolId])
  @@unique([staffNumber, schoolId])
  @@index([schoolId, isActive])
  @@index([departmentId])
  @@index([houseId])
  @@index([profileId])
  @@map("teachers")
}

model Staff {
  id              String         @id @default(cuid())
  profileId       String         @unique
  schoolId        String
  staffId         String
  staffNumber     String?
  staffType       StaffType
  department      String?
  jobTitle        String?
  employmentType  EmploymentType @default(FULL_TIME)
  hireDate        DateTime       @default(now()) @db.Date
  contractEndDate DateTime?      @db.Date
  monthlySalary   Decimal?       @db.Decimal(10, 2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  documents       Document[]
  profile         UserProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([staffId, schoolId])
  @@unique([staffNumber, schoolId])
  @@index([schoolId, isActive])
  @@index([staffType])
  @@index([profileId])
  @@map("staff")
}

model Guardian {
  id                 String            @id @default(cuid())
  profileId          String?           @unique // Optional - only if guardian can login
  schoolId           String
  guardianId         String
  firstName          String
  lastName           String
  otherNames         String?
  phone              String
  alternatePhone     String?
  email              String?
  gender             Gender?
  relationshipType   GuardianType
  occupation         String?
  employer           String?
  workAddress        String?
  workPhone          String?
  residentialAddress String?
  city               String?
  region             String?
  canLogin           Boolean           @default(false)
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  students           GuardianStudent[]
  profile            UserProfile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([guardianId, schoolId])
  @@index([schoolId, isActive])
  @@index([profileId])
  @@index([email])
  @@index([canLogin])
  @@map("guardians")
}

model GuardianStudent {
  id             String   @id @default(cuid())
  guardianId     String
  studentId      String
  isPrimary      Boolean  @default(false)
  canPickup      Boolean  @default(true)
  receiveReports Boolean  @default(true)
  receiveAlerts  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  guardian       Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
  @@index([isPrimary])
  @@map("guardian_students")
}

model House {
  id              String    @id @default(cuid())
  schoolId        String
  name            String
  code            String
  description     String?
  color           String?
  motto           String?
  houseTeacherId  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  houseTeacher    Teacher?  @relation("HouseTeacher", fields: [houseTeacherId], references: [id])
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students        Student[]
  teachersInHouse Teacher[] @relation("TeacherHouse")

  @@unique([code, schoolId])
  @@index([houseTeacherId])
  @@index([schoolId, isActive])
  @@map("houses")
}

model AcademicYear {
  id          String       @id @default(cuid())
  schoolId    String
  name        String
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  isCurrent   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bills       Bill[]
  classes     Class[]
  enrollments Enrollment[]
  terms       Term[]

  @@unique([name, schoolId])
  @@index([schoolId, isCurrent])
  @@index([startDate, endDate])
  @@map("academic_years")
}

model Term {
  id               String            @id @default(cuid())
  academicYearId   String
  name             String
  termNumber       Int
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  isCurrent        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessmentScores AssessmentScore[]
  bills            Bill[]
  enrollments      Enrollment[]
  remarks          Remark[]
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, termNumber])
  @@index([academicYearId])
  @@index([isCurrent])
  @@index([startDate, endDate])
  @@map("terms")
}

model Department {
  id                   String    @id @default(cuid())
  schoolId             String
  name                 String
  code                 String
  description          String?
  headOfDeptId         String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  headOfDept           Teacher?  @relation("DepartmentHead", fields: [headOfDeptId], references: [id])
  school               School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students             Student[]
  subjects             Subject[]
  teachersInDepartment Teacher[] @relation("TeacherDepartment")

  @@unique([code, schoolId])
  @@index([headOfDeptId])
  @@index([schoolId, isActive])
  @@map("departments")
}

model Class {
  id             String         @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  level          String
  section        String?
  capacity       Int?
  classTeacherId String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subjects       ClassSubject[]
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher   Teacher?       @relation(fields: [classTeacherId], references: [id])
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments    Enrollment[]
  students       Student[]

  @@unique([name, academicYearId, schoolId])
  @@index([schoolId, isActive])
  @@index([academicYearId])
  @@index([classTeacherId])
  @@map("classes")
}

model Subject {
  id               String            @id @default(cuid())
  schoolId         String
  departmentId     String
  name             String
  code             String
  description      String?
  creditHours      Int               @default(1)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessmentScores AssessmentScore[]
  classSubjects    ClassSubject[]
  teachers         SubjectTeacher[]
  department       Department        @relation(fields: [departmentId], references: [id])
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([code, schoolId])
  @@index([schoolId, isActive])
  @@index([departmentId])
  @@map("subjects")
}

model ClassSubject {
  id           String   @id @default(cuid())
  classId      String
  subjectId    String
  isCompulsory Boolean  @default(true)
  createdAt    DateTime @default(now())
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  subjectId String
  teacherId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("subject_teachers")
}

model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String
  termId         String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term           Term?            @relation(fields: [termId], references: [id])

  @@unique([studentId, classId, academicYearId, termId])
  @@index([studentId])
  @@index([classId, academicYearId, status])
  @@index([academicYearId])
  @@index([termId])
  @@map("enrollments")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  date       DateTime         @db.Date
  status     AttendanceStatus
  remarks    String?
  markedById String
  markedAt   DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date, status])
  @@index([markedById])
  @@map("attendances")
}

model GradingSystem {
  id                  String               @id @default(cuid())
  schoolId            String?
  name                String
  code                String
  description         String?
  isSystemDefault     Boolean              @default(false)
  isSchoolDefault     Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdById         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assessmentTemplates AssessmentTemplate[]
  gradeScales         GradeScale[]
  createdBy           User?                @relation(fields: [createdById], references: [id])
  school              School?              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([code, schoolId])
  @@index([createdById])
  @@index([schoolId, isActive])
  @@index([isSystemDefault])
  @@index([isSchoolDefault])
  @@map("grading_systems")
}

model GradeScale {
  id              String        @id @default(cuid())
  gradingSystemId String
  grade           String
  description     String
  minScore        Decimal       @db.Decimal(5, 2)
  maxScore        Decimal       @db.Decimal(5, 2)
  gradePoint      Decimal       @db.Decimal(3, 2)
  displayOrder    Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  gradingSystem   GradingSystem @relation(fields: [gradingSystemId], references: [id], onDelete: Cascade)

  @@unique([gradingSystemId, grade])
  @@index([gradingSystemId])
  @@index([minScore, maxScore])
  @@map("grade_scales")
}

model AssessmentTemplate {
  id               String                @id @default(cuid())
  schoolId         String
  gradingSystemId  String
  name             String
  description      String?
  classLevel       String?
  subjectCode      String?
  termNumber       Int?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  components       AssessmentComponent[]
  assessmentScores AssessmentScore[]
  gradingSystem    GradingSystem         @relation(fields: [gradingSystemId], references: [id])
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
  @@index([gradingSystemId])
  @@index([classLevel, subjectCode])
  @@map("assessment_templates")
}

model AssessmentComponent {
  id            String             @id @default(cuid())
  templateId    String
  name          String
  componentType AssessmentType
  maxMarks      Decimal            @db.Decimal(6, 2)
  weight        Decimal            @db.Decimal(5, 2)
  displayOrder  Int
  isRequired    Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  template      AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  scores        ComponentScore[]

  @@index([templateId])
  @@index([componentType])
  @@map("assessment_components")
}

model AssessmentScore {
  id              String             @id @default(cuid())
  studentId       String
  subjectId       String
  termId          String
  templateId      String
  totalScore      Decimal            @db.Decimal(6, 2)
  percentage      Decimal            @db.Decimal(5, 2)
  grade           String?
  gradePoint      Decimal?           @db.Decimal(3, 2)
  position        Int?
  remarks         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  template        AssessmentTemplate @relation(fields: [templateId], references: [id])
  term            Term               @relation(fields: [termId], references: [id], onDelete: Cascade)
  componentScores ComponentScore[]

  @@unique([studentId, subjectId, termId])
  @@index([studentId, termId])
  @@index([subjectId, termId])
  @@index([templateId])
  @@map("assessment_scores")
}

model ComponentScore {
  id                String              @id @default(cuid())
  assessmentScoreId String
  componentId       String
  marksObtained     Decimal             @db.Decimal(6, 2)
  maxMarks          Decimal             @db.Decimal(6, 2)
  percentage        Decimal             @db.Decimal(5, 2)
  weightedScore     Decimal             @db.Decimal(6, 2)
  recordedById      String?
  recordedAt        DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assessmentScore   AssessmentScore     @relation(fields: [assessmentScoreId], references: [id], onDelete: Cascade)
  component         AssessmentComponent @relation(fields: [componentId], references: [id])
  recordedBy        User?               @relation(fields: [recordedById], references: [id])

  @@unique([assessmentScoreId, componentId])
  @@index([assessmentScoreId])
  @@index([componentId])
  @@index([recordedById])
  @@map("component_scores")
}

model Remark {
  id         String     @id @default(cuid())
  studentId  String
  teacherId  String
  termId     String
  remarkType RemarkType
  content    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id])
  term       Term       @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([studentId, termId])
  @@index([teacherId])
  @@index([remarkType])
  @@map("remarks")
}

model TranscriptRequest {
  id            String                @id @default(cuid())
  studentId     String
  requestType   TranscriptRequestType
  purpose       String?
  status        RequestStatus         @default(PENDING)
  requestedAt   DateTime              @default(now())
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  processedBy   User?                 @relation(fields: [processedById], references: [id])
  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([requestedAt])
  @@index([processedById])
  @@map("transcript_requests")
}

model ChartAccount {
  id                 String          @id @default(cuid())
  schoolId           String
  code               String
  name               String
  description        String?
  accountType        AccountType
  category           AccountCategory
  parentId           String?
  balance            Decimal         @default(0) @db.Decimal(15, 2)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  parent             ChartAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children           ChartAccount[]  @relation("AccountHierarchy")
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creditTransactions Transaction[]   @relation("CreditAccount")
  debitTransactions  Transaction[]   @relation("DebitAccount")

  @@unique([code, schoolId])
  @@index([schoolId, accountType])
  @@index([category])
  @@index([parentId])
  @@index([isActive])
  @@map("chart_accounts")
}

model FeeStructure {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  description String?
  classLevel  String?
  termBased   Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bills       Bill[]
  items       FeeItem[]
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, isActive])
  @@map("fee_structures")
}

model FeeItem {
  id               String             @id @default(cuid())
  feeStructureId   String
  name             String
  description      String?
  amount           Decimal            @db.Decimal(10, 2)
  category         FeeCategory?
  customCategoryId String?
  isOptional       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  billItems        BillItem[]
  customCategory   CustomFeeCategory? @relation(fields: [customCategoryId], references: [id])
  feeStructure     FeeStructure       @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@index([feeStructureId])
  @@index([category])
  @@index([customCategoryId])
  @@map("fee_items")
}

model Bill {
  id             String        @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  termId         String?
  feeStructureId String?
  billNumber     String
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount  Decimal       @db.Decimal(10, 2)
  status         BillStatus    @default(PENDING)
  dueDate        DateTime?     @db.Date
  issuedAt       DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          BillItem[]
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id])
  term           Term?         @relation(fields: [termId], references: [id])
  payments       Payment[]

  @@unique([billNumber, schoolId])
  @@index([schoolId, status])
  @@index([studentId, academicYearId, status])
  @@index([billNumber])
  @@index([dueDate])
  @@index([academicYearId])
  @@index([termId])
  @@index([feeStructureId])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  feeItemId   String?
  description String
  amount      Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  feeItem     FeeItem? @relation(fields: [feeItemId], references: [id])

  @@index([billId])
  @@index([feeItemId])
  @@map("bill_items")
}

model Payment {
  id              String        @id @default(cuid())
  schoolId        String
  studentId       String
  billId          String?
  paymentNumber   String
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @db.Date
  referenceNumber String?
  transactionId   String?
  status          PaymentStatus @default(COMPLETED)
  notes           String?
  recordedById    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bill            Bill?         @relation(fields: [billId], references: [id])
  recordedBy      User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id])
  transaction     Transaction?  @relation(fields: [transactionId], references: [id])

  @@unique([paymentNumber, schoolId])
  @@index([schoolId, paymentDate])
  @@index([studentId])
  @@index([billId])
  @@index([paymentNumber])
  @@index([status])
  @@index([transactionId])
  @@index([recordedById])
  @@map("payments")
}

model Transaction {
  id                String                     @id @default(cuid())
  schoolId          String
  transactionNumber String
  transactionDate   DateTime                   @db.Date
  description       String
  amount            Decimal                    @db.Decimal(15, 2)
  debitAccountId    String
  creditAccountId   String
  transactionType   TransactionType
  category          TransactionCategory?
  customCategoryId  String?
  referenceType     String?
  referenceId       String?
  referenceNumber   String?
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  payments          Payment[]
  creditAccount     ChartAccount               @relation("CreditAccount", fields: [creditAccountId], references: [id])
  customCategory    CustomTransactionCategory? @relation(fields: [customCategoryId], references: [id])
  debitAccount      ChartAccount               @relation("DebitAccount", fields: [debitAccountId], references: [id])
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([transactionNumber, schoolId])
  @@index([schoolId, transactionDate])
  @@index([schoolId, transactionType])
  @@index([transactionNumber])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([category])
  @@index([customCategoryId])
  @@map("transactions")
}

model CustomFeeCategory {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeItems    FeeItem[]

  @@unique([code, schoolId])
  @@index([schoolId, isActive])
  @@map("custom_fee_categories")
}

model CustomExpenseCategory {
  id          String      @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  accountType AccountType
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([code, schoolId])
  @@index([schoolId, isActive])
  @@index([accountType])
  @@map("custom_expense_categories")
}

model CustomTransactionCategory {
  id           String          @id @default(cuid())
  schoolId     String
  name         String
  code         String
  description  String?
  categoryType TransactionType
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([code, schoolId])
  @@index([schoolId, isActive])
  @@index([categoryType])
  @@map("custom_transaction_categories")
}

model Document {
  id           String             @id @default(cuid())
  schoolId     String
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     Int
  entityType   DocumentEntityType
  entityId     String
  studentId    String?
  teacherId    String?
  staffId      String?
  uploadedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff        Staff?             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  student      Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher?           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])

  @@index([uploadedById])
  @@index([schoolId])
  @@index([entityType, entityId])
  @@index([studentId])
  @@index([teacherId])
  @@index([staffId])
  @@map("documents")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Subscription {
  id                    String             @id @default(cuid())
  schoolId              String             @unique
  planType              PlanType           @default(FREE)
  planName              String             @default("Free Plan")
  billingCycle          BillingCycle?
  status                SubscriptionStatus @default(ACTIVE)
  amount                Decimal?           @db.Decimal(10, 2)
  currency              String             @default("USD")
  trialStartsAt         DateTime?
  trialEndsAt           DateTime?
  isOnTrial             Boolean            @default(false)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  stripePaymentMethodId String?
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  maxStudents           Int?
  maxTeachers           Int?
  maxStaff              Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  invoices              InvoiceRecord[]
  school                School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([planType])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model InvoiceRecord {
  id              String        @id @default(cuid())
  subscriptionId  String
  invoiceNumber   String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          InvoiceStatus @default(PENDING)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  paymentMethod   String?
  stripeInvoiceId String?       @unique
  invoiceUrl      String?
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoice_records")
}

