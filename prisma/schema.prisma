generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// BETTER AUTH CORE MODELS
// ============================================
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth relations
  sessions Session[]
  accounts Account[]
  
  // Organization memberships
  members OrganizationMember[]

  // School Management relations
  profile     UserProfile?
  attendances Attendance[]

  @@index([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// ============================================
// BETTER AUTH ORGANIZATION (MAPS TO SCHOOL)
// ============================================
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?  // JSON string for additional data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  school  School?

  @@index([slug])
  @@map("organization")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role           String   // ADMIN, TEACHER, ACCOUNTANT, etc.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@map("organization_member")
}

// ============================================
// SCHOOL (LINKED TO ORGANIZATION)
// ============================================
model School {
  id      String  @id @default(cuid())
  
  // Link to Better Auth Organization
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // School Details
  name    String
  code    String  @unique // Auto-generated
  email   String?
  phone   String?
  address String?
  logo    String?
  motto   String?
  website String?
  
  // Custom Domain Support
  domain  String? @unique // e.g., schoolname.edu.gh

  // Configuration
  currency           String @default("GHS")
  timezone           String @default("Africa/Accra")
  academicYearFormat String @default("YYYY/YYYY")

  // Status
  isActive       Boolean @default(true)
  setupCompleted Boolean @default(false)

  // Relations
  academicYears AcademicYear[]
  departments   Department[]
  classes       Class[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  chartAccounts ChartAccount[]
  transactions  Transaction[]
  bills         Bill[]
  houses        House[]
  roles         Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([domain])
  @@index([isActive])
  @@map("schools")
}

// ============================================
// ROLE-BASED ACCESS CONTROL (RBAC)
// ============================================
model Role {
  id          String @id @default(cuid())
  schoolId    String
  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  
  name        String // Display name: "Teacher", "Accountant"
  code        String // System code: TEACHER, ACCOUNTANT
  description String?
  isSystem    Boolean @default(false) // System roles can't be deleted
  
  permissions RolePermission[]
  profiles    UserProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([code])
  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique // VIEW_STUDENTS, MANAGE_BILLS, etc.
  name        String
  description String?
  category    PermissionCategory
  
  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================
// USER PROFILE (EXTENDED USER DATA)
// ============================================
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal Information
  firstName  String
  lastName   String
  otherNames String?
  phone      String?
  gender     Gender
  dob        DateTime
  location   String?

  // Active Role per School (user can switch)
  activeRoleId String?
  activeRole   Role?   @relation(fields: [activeRoleId], references: [id], onDelete: SetNull)

  // Polymorphic role data
  student Student?
  teacher Teacher?
  staff   Staff?

  // Super Admin flag (can access ALL schools)
  isSuperAdmin Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isSuperAdmin])
  @@index([isActive])
  @@index([activeRoleId])
  @@map("user_profiles")
}

// ============================================
// HOUSE SYSTEM
// ============================================
model House {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  color       String?
  motto       String?

  students Student[]
  teachers Teacher[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, schoolId])
  @@index([schoolId])
  @@index([isActive])
  @@map("houses")
}

// ============================================
// STUDENT & ACADEMIC MODELS
// ============================================
model Student {
  id        String      @id @default(cuid())
  profileId String      @unique
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  studentId     String      @unique
  classId       String?
  class         Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  currentTermId String?
  currentTerm   Term?       @relation("StudentCurrentTerm", fields: [currentTermId], references: [id], onDelete: SetNull)
  houseId       String?
  house         House?      @relation(fields: [houseId], references: [id], onDelete: SetNull)

  guardians          Guardian[]
  enrollments        Enrollment[]
  marks              Mark[]
  exams              Exam[]
  attendances        Attendance[]
  remarks            Remark[]
  transcriptRequests TranscriptRequest[]
  bills              Bill[]
  payments           Payment[]

  isActive       Boolean  @default(true)
  enrollmentDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([classId])
  @@index([departmentId])
  @@index([houseId])
  @@index([isActive])
  @@index([profileId])
  @@map("students")
}

model Guardian {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  relationship GuardianType
  fullName     String
  phone        String
  email        String?
  isPrimary    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@map("guardians")
}

model Teacher {
  id        String      @id @default(cuid())
  profileId String      @unique
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  teacherId    String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  houseId      String?
  house        House?     @relation(fields: [houseId], references: [id], onDelete: SetNull)

  subjects     SubjectTeacher[]
  classTeacher Class[]
  remarks      Remark[]
  guardianOf   Guardian[]

  isActive Boolean  @default(true)
  hireDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([departmentId])
  @@index([houseId])
  @@index([profileId])
  @@map("teachers")
}

model Staff {
  id        String      @id @default(cuid())
  profileId String      @unique
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  staffId    String    @unique
  staffType  StaffType
  department String?

  isActive Boolean  @default(true)
  hireDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([staffType])
  @@index([profileId])
  @@map("staff")
}

// ============================================
// ACADEMIC STRUCTURE (keeping your existing models)
// ============================================
model Class {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name     String
  grade    Int
  capacity Int?

  students       Student[]
  subjects       ClassSubject[]
  classTeacherId String?
  classTeacher   Teacher?       @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, academicYearId, schoolId])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([grade])
  @@map("classes")
}

model Department {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name     String
  code     String
  students Student[]
  teachers Teacher[]
  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, schoolId])
  @@index([schoolId])
  @@map("departments")
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  code        String
  description String?
  creditHours Int     @default(1)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  classSubjects ClassSubject[]
  teachers      SubjectTeacher[]
  exams         Exam[]
  marks         Mark[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, departmentId, schoolId])
  @@index([schoolId])
  @@index([departmentId])
  @@index([isActive])
  @@map("subjects")
}

model ClassSubject {
  id        String  @id @default(cuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model SubjectTeacher {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([subjectId, teacherId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("subject_teachers")
}

model Enrollment {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, academicYearId])
  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([status])
  @@map("enrollments")
}

model Attendance {
  id      String           @id @default(cuid())
  date    DateTime         @db.Date
  status  AttendanceStatus
  remarks String?

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

model AcademicYear {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  classes     Class[]
  terms       Term[]
  enrollments Enrollment[]
  bills       Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([isCurrent])
  @@index([startDate, endDate])
  @@map("academic_years")
}

model Term {
  id         String   @id @default(cuid())
  name       String
  termNumber Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  currentStudents Student[]    @relation("StudentCurrentTerm")
  enrollments     Enrollment[]
  exams           Exam[]
  remarks         Remark[]
  bills           Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, termNumber])
  @@index([academicYearId])
  @@index([startDate, endDate])
  @@map("terms")
}

model Exam {
  id         String   @id @default(cuid())
  name       String
  examType   ExamType
  totalMarks Float
  passMark   Float
  weight     Float    @default(1.0)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  marksObtained Float
  grade         String?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, termId, examType])
  @@index([studentId])
  @@index([subjectId])
  @@index([termId])
  @@index([examType])
  @@map("exams")
}

model Mark {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  component     ExamComponent
  totalMarks    Float
  marksObtained Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([subjectId])
  @@index([component])
  @@map("marks")
}

model TranscriptRequest {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  requestType String
  purpose     String?
  status      RequestStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([requestedAt])
  @@map("transcript_requests")
}

model Remark {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  remarkType RemarkType
  content    String     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([termId])
  @@index([remarkType])
  @@map("remarks")
}

// ============================================
// ACCOUNTING SYSTEM (keeping your models)
// ============================================
model ChartAccount {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  code        String
  name        String
  description String?
  accountType AccountType
  category    AccountCategory

  parentId String?
  parent   ChartAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ChartAccount[] @relation("AccountHierarchy")

  balance Decimal @default(0) @db.Decimal(15, 2)
  isActive Boolean @default(true)

  debitTransactions  Transaction[] @relation("DebitTransactions")
  creditTransactions Transaction[] @relation("CreditTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, schoolId])
  @@index([schoolId])
  @@index([accountType])
  @@index([category])
  @@index([parentId])
  @@map("chart_accounts")
}

model FeeStructure {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name        String
  description String?
  classId     String?
  termBased   Boolean @default(true)

  items FeeItem[]
  bills Bill[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([isActive])
  @@map("fee_structures")
}

model FeeItem {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  name        String
  description String?
  amount      Decimal     @db.Decimal(10, 2)
  isOptional  Boolean     @default(false)
  category    FeeCategory

  billItems BillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([feeStructureId])
  @@index([category])
  @@map("fee_items")
}

model Bill {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  billNumber String @unique

  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)

  totalAmount   Decimal @db.Decimal(10, 2)
  paidAmount    Decimal @default(0) @db.Decimal(10, 2)
  balanceAmount Decimal @db.Decimal(10, 2)

  status   BillStatus @default(PENDING)
  dueDate  DateTime?  @db.Date
  issuedAt DateTime   @default(now())

  items    BillItem[]
  payments Payment[]

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([termId])
  @@index([status])
  @@index([billNumber])
  @@index([dueDate])
  @@map("bills")
}

model BillItem {
  id     String @id @default(cuid())
  billId String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  feeItemId String?
  feeItem   FeeItem? @relation(fields: [feeItemId], references: [id], onDelete: SetNull)

  description String
  amount      Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)
  totalAmount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([feeItemId])
  @@map("bill_items")
}

model Payment {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  billId String?
  bill   Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)

  paymentNumber String  @unique
  amount        Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  paymentDate   DateTime      @db.Date

  referenceNumber String?
  notes           String? @db.Text

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  status PaymentStatus @default(COMPLETED)

  recordedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([billId])
  @@index([paymentNumber])
  @@index([paymentDate])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

model Transaction {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  transactionNumber String   @unique
  transactionDate   DateTime @db.Date

  description String  @db.Text
  amount      Decimal @db.Decimal(15, 2)

  debitAccountId  String
  debitAccount    ChartAccount @relation("DebitTransactions", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId String
  creditAccount   ChartAccount @relation("CreditTransactions", fields: [creditAccountId], references: [id], onDelete: Restrict)

  transactionType TransactionType
  category        TransactionCategory?

  referenceType   String?
  referenceId     String?
  referenceNumber String?

  payments Payment[]

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([transactionNumber])
  @@index([transactionDate])
  @@index([transactionType])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([category])
  @@map("transactions")
}

// ============================================
// ENUMS
// ============================================

enum Gender {
  MALE
  FEMALE
}

enum GuardianType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum StaffType {
  ADMIN
  DRIVER
  MATRON
  ACCOUNTANT
  HEADMASTER
  SMC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

enum ExamType {
  TERMINAL
  MOCK
  MID_TERM
  END_TERM
}

enum ExamComponent {
  CLASS_TEST
