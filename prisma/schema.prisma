// ============================================================================
// SUPPORT / TICKETING
// ============================================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String         @id @default(cuid())
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  // Who submitted the ticket (any User)
  submittedById String
  submittedBy   user   @relation("SubmittedTickets", fields: [submittedById], references: [id])

  // Which school this ticket belongs to (optional — superAdmin tickets have no school)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  // Who is handling this ticket (SuperAdmin user)
  assignedToId String?
  assignedTo   user?   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  replies   TicketReply[]

  @@index([submittedById])
  @@index([schoolId])
  @@index([status])
  @@map("support_tickets")
}

model TicketReply {
  id       String @id @default(cuid())
  ticketId String
  authorId String
  message  String

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author user          @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

model Club {
  id                String   @id @default(cuid())
  schoolId          String
  name              String
  description       String?
  teacherInChargeId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherInCharge Teacher?     @relation(fields: [teacherInChargeId], references: [id], onDelete: SetNull)
  members         ClubMember[]

  @@unique([name, schoolId])
  @@index([schoolId])
  @@index([teacherInChargeId])
  @@map("clubs")
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  studentId String
  joinedAt  DateTime @default(now())
  role      String? // e.g., President, Secretary

  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
  @@index([clubId])
  @@index([studentId])
  @@map("club_members")
}

model PayrollRecord {
  id            String        @id @default(cuid())
  schoolId      String
  month         Int // 1-12
  year          Int
  status        PayrollStatus @default(DRAFT)
  totalGross    Decimal       @db.Decimal(15, 2)
  totalNet      Decimal       @db.Decimal(15, 2)
  totalTax      Decimal       @db.Decimal(15, 2)
  totalSSNIT    Decimal       @db.Decimal(15, 2)
  processedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  academicYearId String?
  termId         String?

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  term         Term?         @relation(fields: [termId], references: [id])
  processedBy  user?         @relation("PayrollProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  payslips     Payslip[]

  @@unique([schoolId, month, year])
  @@index([academicYearId])
  @@index([termId])
  @@map("payroll_records")
}

model Payslip {
  id              String  @id @default(cuid())
  payrollRecordId String
  schoolId        String
  staffId         String?
  teacherId       String?

  basicSalary Decimal @db.Decimal(15, 2)
  allowances  Decimal @default(0) @db.Decimal(15, 2)
  grossSalary Decimal @db.Decimal(15, 2)

  // Deductions
  ssnitEmployee   Decimal @db.Decimal(15, 2) // 5.5%
  ssnitEmployer   Decimal @db.Decimal(15, 2) // 13%
  incomeTax       Decimal @db.Decimal(15, 2) // PAYE
  otherDeductions Decimal @default(0) @db.Decimal(15, 2)

  netSalary Decimal @db.Decimal(15, 2)

  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff         Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  teacher       Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([payrollRecordId])
  @@index([staffId])
  @@index([teacherId])
  @@map("payslips")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableEntryType {
  LESSON
  BREAK
  ACTIVITY
}

model Classroom {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([name, schoolId])
  @@map("classrooms")
}

/// Defines a reusable period (e.g. "Period 1: 08:00–08:45") with no day attached.
/// departmentId = null means school-wide; set = department-specific schedule.
model PeriodTemplate {
  id           String  @id @default(cuid())
  schoolId     String
  /// null → applies to all departments; set → department-specific schedule
  departmentId String?
  name         String  // "Period 1", "Lunch Break"
  startTime    String  // "HH:mm"
  endTime      String  // "HH:mm"
  sortOrder    Int     @default(0)

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department Department? @relation("DeptPeriodTemplates", fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, departmentId, startTime, endTime])
  @@index([schoolId, departmentId])
  @@map("period_templates")
}

model TimeSlot {
  id           String    @id @default(cuid())
  schoolId     String
  /// null → school-wide slot; set → only appears on this department's timetable
  departmentId String?
  dayOfWeek    DayOfWeek
  startTime    String // "HH:mm"
  endTime      String // "HH:mm"
  label        String? // e.g., "Period 1"

  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department       Department?      @relation("DeptTimeSlots", fields: [departmentId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, departmentId, dayOfWeek, startTime, endTime])
  @@index([schoolId, departmentId])
  @@map("time_slots")
}

model TimetableEntry {
  id             String             @id @default(cuid())
  schoolId       String
  classId        String?
  departmentId   String?
  /// LESSON = normal class, BREAK = lunch/recess, ACTIVITY = P.E./Worship/Library
  type           TimetableEntryType @default(LESSON)
  /// Human-readable label for breaks/activities e.g. "Lunch", "Worship"
  label          String?
  subjectId      String?  // Optional: Breaks and Activities may not have a subject
  teacherId      String?  // Optional: Teacherless activities (P.E., Worship) allowed
  timeSlotId     String
  classroomId    String?
  academicYearId String
  termId         String?

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class?             @relation(fields: [classId], references: [id], onDelete: Cascade)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subject      Subject?           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timeSlot     TimeSlot           @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  classroom    Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  // Teacher conflict: one teacher can only be in one place per time slot (enforced at API layer for nullables)
  @@unique([classroomId, timeSlotId, academicYearId])
  // One class/dept can only have one entry per slot
  @@unique([classId, timeSlotId, academicYearId])
  @@unique([departmentId, timeSlotId, academicYearId])
  @@index([classId])
  @@index([departmentId])
  @@index([teacherId])
  @@index([timeSlotId])
  @@map("timetable_entries")
}

model AssessmentTemplateClass {
  id         String @id @default(cuid())
  templateId String
  classId    String

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  class    Class              @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([templateId, classId])
}

model AssessmentExtension {
  id         String   @id @default(cuid())
  templateId String
  classId    String
  teacherId  String?
  deadline   DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  class    Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher  Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([templateId, classId, teacherId])
}

model ReportCardSetClass {
  id      String @id @default(cuid())
  setId   String
  classId String

  set   ReportCardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  class Class         @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([setId, classId])
}

enum AssessmentScoreStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINAL
}
